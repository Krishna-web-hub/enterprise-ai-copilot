# ============================================================
# Enterprise AI Analytics Copilot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Required for basic operation: Database + JWT
# Required for AI features: OPENAI_API_KEY
# Optional: Redis (caching), Qdrant (RAG vector search)

# ─── Application ───────────────────────────────────────────
APP_NAME=Enterprise AI Analytics Copilot
APP_ENV=development          # development | staging | production
DEBUG=true                   # true: readable logs, SQL echo | false: JSON logs, no echo
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ─── Backend Server ───────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1            # Production: 2 * CPU_CORES + 1

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# ─── Database (PostgreSQL) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_copilot
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis (caching, optional) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ───────────────────────────────────
# IMPORTANT: Generate a strong random key for production!
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OpenAI (required for AI features) ───────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o           # gpt-4o | gpt-4o-mini | gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1           # Low for deterministic tasks (SQL), higher for creative (reports)

# ─── SQL Engine ───────────────────────────────────────────
SQL_MAX_ROWS=1000             # Max rows returned from any NL2SQL query
SQL_QUERY_TIMEOUT_SECONDS=15  # Kill slow queries after this

# ─── ML Engine ────────────────────────────────────────────
ML_CV_FOLDS=3                 # Cross-validation folds for algorithm auto-selection
ML_TEST_SIZE=0.2              # Hold-out fraction for evaluation
ML_SHAP_SAMPLE_SIZE=100       # Rows used for SHAP computation (higher = slower but more accurate)

# ─── Vector Database (Qdrant - for RAG) ──────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ─── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MODELS_DIR=./data/models
MAX_UPLOAD_SIZE_MB=100

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
