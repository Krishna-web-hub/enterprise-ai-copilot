# ============================================================
# Production Environment Template
# ============================================================
# Copy to .env.production and fill in all values.
# NEVER commit .env.production to version control.

# ─── Application ───────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ─── Database (use managed service: RDS, Cloud SQL, etc.) ──
POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=ai_copilot
POSTGRES_USER=copilot_prod
POSTGRES_PASSWORD=STRONG_RANDOM_PASSWORD_HERE

# ─── Redis (use managed: ElastiCache, Memorystore, etc.) ───
REDIS_HOST=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379

# ─── JWT (generate: python -c "import secrets; print(secrets.token_hex(32))") ─
JWT_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-production-key

# ─── Storage ──────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_BUCKET_NAME=your-copilot-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET

# ─── Qdrant (use managed Qdrant Cloud or self-hosted) ─────
QDRANT_HOST=your-qdrant-host
QDRANT_PORT=6333

# ─── CORS (your production domain) ────────────────────────
CORS_ORIGINS=https://your-domain.com
